{
  "appId": "com.vodaoftucson.hours",
  "appName": "Voda Of Tucson Hours",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "automatic",
    "scheme": "VodaHours"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#020617",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#020617",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark"
    }
  }
}
